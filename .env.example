# =====================================================
# AnimeGraph Nexus - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# =====================================================

# =====================================================
# SUPABASE DATABASE
# =====================================================
# Get these values from your Supabase project:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
#
# Connection string format:
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# =====================================================
# SUPABASE (Optional - for Auth & Storage)
# =====================================================
# Get these values from: Supabase Dashboard > Settings > API

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Supabase publishable key (public, safe to expose)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key-here"

# Supabase secret key (server only, never use NEXT_PUBLIC_)
SUPABASE_SECRET_KEY="sb_secret_your-key-here"

# Legacy projects may use these names instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# =====================================================
# APPLICATION SETTINGS
# =====================================================

# Environment mode
NODE_ENV="development"

# App URL (for CORS and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =====================================================
# JIKAN API (MyAnimeList Unofficial API)
# =====================================================
# Jikan API is FREE and doesn't require an API key
# Rate limit: 3 requests per second
# Documentation: https://jikan.moe/docs/v4

# =====================================================
# RDF/SEMANTIC WEB SETTINGS
# =====================================================
# Namespace for RDF generation
RDF_NAMESPACE="http://example.org/animegraph#"

# =====================================================
# CACHING (Optional - for production)
# =====================================================
# Uncomment if using Redis for caching
# REDIS_URL="redis://default:[PASSWORD]@redis-[PROJECT-REF].supabase.co:6379"

# =====================================================
# LOGGING
# =====================================================
# Set to "debug" for development, "error" for production
LOG_LEVEL="info"
