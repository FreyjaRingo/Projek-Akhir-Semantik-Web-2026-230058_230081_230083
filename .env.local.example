# =====================================================
# AnimeGraph Nexus - Local Development .env
# =====================================================
# This file is for LOCAL development only
# DO NOT commit this file to version control!
# =====================================================

# =====================================================
# SUPABASE DATABASE
# =====================================================
# IMPORTANT: Replace these with your actual Supabase credentials
#
# How to get these values:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > Database
# 4. Copy the "Connection string" (URI) from "Connection pooling"
#
# The URI format is:
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase API settings
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key-here"
SUPABASE_SECRET_KEY="sb_secret_your-key-here"

# =====================================================
# FOR LOCAL PostgreSQL (Alternative to Supabase)
# =====================================================
# If you prefer to use a local PostgreSQL installation:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/animegraph"
# =====================================================

# =====================================================
# APPLICATION SETTINGS
# =====================================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =====================================================
# RDF/SEMANTIC WEB SETTINGS
# =====================================================
RDF_NAMESPACE="http://example.org/animegraph#"
